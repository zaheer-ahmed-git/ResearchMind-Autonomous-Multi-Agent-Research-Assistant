# Copy to .env and fill values as needed. Never commit real secrets.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
USE_LLM=false

API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

MAX_SUBTASKS=5
MAX_REFINE_LOOPS=2
QUALITY_THRESHOLD=0.72
MEMORY_CAPACITY=24
MEMORY_PRUNE_RATIO=0.45
RANKING_RECENCY_BIAS=0.15
DEMO_LATENCY_MS=12

# Frontend
NEXT_PUBLIC_API_BASE=http://localhost:8000
